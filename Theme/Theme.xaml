<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:MeiRi">

    <core:BoolVisibilityConverter x:Key="BoolVis" />
    <core:StringVisibilityConverter x:Key="StringVis" />
    <core:LevelBrushConverter x:Key="LevelBrush" />
    <core:LevelInkConverter x:Key="LevelInk" />

    <!-- ============ palette ============ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5B67E8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C58D6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF0FE" />
    <SolidColorBrush x:Key="AccentSoft2Brush" Color="#E3E7FD" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#242731" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#878DA0" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#B4B9C8" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EEF0F5" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#B8F0F2F8" />
    <SolidColorBrush x:Key="HoverBrush" Color="#A6EDEFF7" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F1576F" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2FBE8F" />
    <SolidColorBrush x:Key="GhostTextBrush" Color="#AEB4C4" />

    <!-- remarks under a task -->
    <SolidColorBrush x:Key="NoteBarBrush" Color="#D3D9E8" />
    <SolidColorBrush x:Key="NoteEditBrush" Color="#9AEEF1FA" />

    <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="0.55,1">
        <GradientStop Color="#F7FEFFFF" Offset="0" />
        <GradientStop Color="#F0F6F9FE" Offset="0.5" />
        <GradientStop Color="#F4FAFCFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="GlassInnerBrush" Color="#A8F7F8FC" />
    <SolidColorBrush x:Key="GlassInnerHoverBrush" Color="#8FE9ECF5" />
    <SolidColorBrush x:Key="GlassSegmentBrush" Color="#8FE4E7F1" />
    <SolidColorBrush x:Key="GlassSelectedBrush" Color="#C4EEF1FF" />
    <SolidColorBrush x:Key="GlassSelectedBorderBrush" Color="#99DCE1FB" />

    <DropShadowEffect x:Key="CardShadow" Color="#101731" BlurRadius="26" ShadowDepth="6"
                      Direction="270" Opacity="0.17" RenderingBias="Performance" />
    <DropShadowEffect x:Key="SoftShadow" Color="#101731" BlurRadius="16" ShadowDepth="3"
                      Direction="270" Opacity="0.13" RenderingBias="Performance" />
    <!-- the hover preview shows and hides constantly, so it gets the cheapest shadow -->
    <DropShadowEffect x:Key="PreviewShadow" Color="#101731" BlurRadius="11" ShadowDepth="2"
                      Direction="270" Opacity="0.11" RenderingBias="Performance" />

    <!--
      A blur effect is re-rendered whenever its element changes, and it is also re-computed for
      every new window (measured: the first Show() of a card costs 250 ms with the effect and
      85 ms without, and typing drops from 70 fps to 37 fps while the text sits on top of it).
      The shadow is therefore painted as a few stacked translucent rings: no effect, no per-frame
      cost, no per-window cost, and at these alphas it is indistinguishable from a soft blur.
    -->
    <Style x:Key="CardShadowRing" TargetType="ContentControl">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="33" BorderThickness="3" BorderBrush="#06101731" Margin="-11" />
                        <Border CornerRadius="30" BorderThickness="2" BorderBrush="#0A101731" Margin="-8" />
                        <Border CornerRadius="28" BorderThickness="3" BorderBrush="#10101731" Margin="-6" />
                        <Border CornerRadius="25" BorderThickness="2" BorderBrush="#17101731" Margin="-3" />
                        <Border CornerRadius="23" BorderThickness="1" BorderBrush="#1F101731" Margin="-1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <FontFamily x:Key="AppFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- tooltips are popups too: they need the CJK font explicitly -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ============ text helpers ============ -->
    <Style x:Key="GlyphText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- ============ buttons ============ -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" />
                        <Border x:Name="Hv" CornerRadius="8" Background="{StaticResource HoverBrush}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="Hv" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" Background="{StaticResource AccentBrush}" CornerRadius="9" />
                        <Border x:Name="Hv" Background="White" CornerRadius="9" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hv" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Hv" CornerRadius="7" Background="{StaticResource HoverBrush}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="Hv" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- small rounded chip: the "待定" entry point in the calendar header -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlassSegmentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" />
                        <Border x:Name="Hv" CornerRadius="7" Background="White" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="Hv" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ scrollbars ============ -->
    <Style x:Key="ScrollRepeatButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="#D5D9E5" CornerRadius="3" Margin="1,2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#B7BED0" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#A2AABF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="1,0">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollRepeatButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollRepeatButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ text boxes ============ -->
    <Style x:Key="PlainTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.25" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="7" Padding="9,4" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ flyout menu (the "..." popups) ============ -->
    <Style x:Key="FlyoutCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
    </Style>

    <Style x:Key="FlyoutItemButton" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="8,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft2Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="FlyoutItemTemplate">
        <Grid>
            <Button x:Name="ItemBtn" Style="{StaticResource FlyoutItemButton}" Command="{Binding Command}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GlyphText" Grid.Column="0" Text="{Binding Glyph}"
                               FontFamily="{StaticResource IconFont}" FontSize="12"
                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Text}" FontSize="12.5"
                               FontFamily="{StaticResource AppFont}"
                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="Check" Grid.Column="2" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                               FontSize="11" Margin="12,0,2,0" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               Visibility="{Binding IsChecked, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Button>
            <Border x:Name="Sep" Height="1" Background="{StaticResource DividerBrush}" Margin="8,4"
                    Visibility="Collapsed" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DangerBrush}" />
                <Setter TargetName="GlyphText" Property="Foreground" Value="{StaticResource DangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                <Setter TargetName="ItemBtn" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Sep" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
