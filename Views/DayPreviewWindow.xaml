<Window x:Class="MeiRi.Views.DayPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="304" Height="470"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False" ShowActivated="False"
        Focusable="False" WindowStartupLocation="Manual" Left="0" Top="0"
        FontFamily="{StaticResource AppFont}" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="14" IsHitTestVisible="False">
        <Border x:Name="Card" VerticalAlignment="Top" CornerRadius="14" Background="{StaticResource GlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                Effect="{StaticResource PreviewShadow}"
                Padding="16,14,14,14">
            <StackPanel>
                <Grid Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DateText" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="WeekText" FontSize="11" Margin="8,3,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
                </Grid>
                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,10,0,4" />

                <!-- headings + one line per task: a glance, not the full card.
                     The list is clipped instead of scrollable (nothing here can be dragged),
                     and the "…" row below says there is more. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="SectionScroller" Grid.Row="0" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="282">
                        <ItemsControl x:Name="Sections" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3,0,1">
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,2"
                                                    Visibility="{Binding ShowTitle, Converter={StaticResource BoolVis}}">
                                            <Border Width="3" Height="12" CornerRadius="2"
                                                    Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SecTitle" Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                       Margin="7,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,2,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="15" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                            <Ellipse x:Name="C" Stroke="#C7CCDA" StrokeThickness="1.3" />
                                                            <Path x:Name="K" Data="M 2.6,6 L 5,8.5 L 9.4,3.3"
                                                                  Stroke="White" StrokeThickness="1.4" Visibility="Collapsed"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        </Grid>
                                                        <TextBlock x:Name="T" Grid.Column="1" Text="{Binding Text}"
                                                                   Margin="6,0,0,0" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter TargetName="C" Property="Fill" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="C" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="K" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                                            <Setter TargetName="T" Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border x:Name="MoreHint" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False"
                            Margin="0,3,0,1" HorizontalAlignment="Center">
                        <TextBlock Text="···" FontSize="15" Foreground="{StaticResource TextTertiaryBrush}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
