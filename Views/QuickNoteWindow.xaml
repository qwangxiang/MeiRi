<Window x:Class="MeiRi.Views.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="CanMinimize" ShowInTaskbar="True" Topmost="False" ShowActivated="True"
        Title="每日 · 便签"
        WindowStartupLocation="Manual" Left="0" Top="0"
        FontFamily="{StaticResource AppFont}" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid Margin="12">
        <ContentControl Style="{StaticResource CardShadowRing}" />
        <Border x:Name="Card" CornerRadius="14" Background="{StaticResource GlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <Grid x:Name="Header" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      MouseMove="Header_MouseMove"
                      MouseLeftButtonUp="Header_MouseLeftButtonUp">
                    <Border x:Name="MergeHighlight" Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="14,14,0,0" Visibility="Collapsed" IsHitTestVisible="False" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="TabBar" Margin="8,0,4,0" VerticalAlignment="Center" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl x:Name="Tabs" ItemsSource="{Binding Notes}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Tab" Background="Transparent" CornerRadius="7"
                                                    Padding="8,3,3,3" Margin="0,0,3,0" Cursor="Hand"
                                                    Tag="{Binding}" ToolTip="{Binding Title}"
                                                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                                    MouseLeftButtonUp="Tab_MouseLeftButtonUp">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TabText" Text="{Binding Title}" FontSize="11"
                                                               MaxWidth="92" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <Button x:Name="TabClose" Style="{StaticResource IconButton}"
                                                            Content="&#xE711;" FontSize="8" Width="17" Height="17"
                                                            Margin="3,0,0,0" ToolTip="关闭这一栏"
                                                            Click="TabClose_Click" />
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Tab" Property="Background"
                                                            Value="{StaticResource SurfaceBrush}" />
                                                    <Setter TargetName="TabText" Property="Foreground"
                                                            Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button x:Name="AddTabButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                    Content="&#xE710;" FontSize="10" Width="22" Height="22" Margin="1,0,0,0"
                                    ToolTip="新建一栏便签" Click="AddTab_Click" />
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,7,0"
                                    VerticalAlignment="Center">
                            <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Content="&#xE8C8;" FontSize="13"
                                    ToolTip="复制全部内容" Click="Copy_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="12"
                                    ToolTip="清空" Click="Clear_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                    ToolTip="关闭" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <TextBox x:Name="Editor" Grid.Row="1"
                         Text="{Binding Selected.Text, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource AccentBrush}" SelectionBrush="{StaticResource AccentBrush}"
                         SelectionOpacity="0.22" FontSize="13.5" Padding="18,2,16,8"
                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" SpellCheck.IsEnabled="False"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         TextChanged="Editor_TextChanged"
                         ContextMenu="{x:Null}"
                         UndoLimit="200" />

                <Thumb x:Name="ResizeThumb" Grid.Row="1" Width="18" Height="18" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0.0001"
                       DragDelta="ResizeThumb_DragDelta" />

                <Border x:Name="ToastHost" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,16" Background="{StaticResource GlassSegmentBrush}" CornerRadius="9"
                        Padding="10,4" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="Toast" Text="已复制" FontSize="10.5"
                               Foreground="{StaticResource AccentBrush}" />
                </Border>

                <TextBlock x:Name="CharCountText" Grid.Row="2" Text="共 0 字"
                           Margin="19,0,18,4" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                           FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
