<UserControl x:Class="MeiRi.Views.TaskBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:meiri="clr-namespace:MeiRi"
             FontFamily="{StaticResource AppFont}" FontSize="12"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- ===== one task row ===== -->
        <DataTemplate x:Key="TaskRow">
            <Border x:Name="Row" Background="Transparent" CornerRadius="8" Tag="{Binding}" Cursor="Hand"
                    MouseLeftButtonDown="Row_MouseLeftButtonDown"
                    MouseMove="Row_MouseMove"
                    MouseLeftButtonUp="Row_MouseLeftButtonUp">
                <Grid>
                    <Border x:Name="HoverBg" CornerRadius="8" Background="{StaticResource HoverBrush}" Opacity="0" />
                    <Grid Margin="4,6,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="Tick" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0"
                              Background="Transparent" Cursor="Hand" ToolTip="标记完成 / 取消完成">
                            <Ellipse x:Name="Circle" Stroke="#C7CCDA" StrokeThickness="1.4" Fill="Transparent" />
                            <Path x:Name="Check" Data="M 4,9.5 L 7.6,13 L 14,5" Stroke="White" StrokeThickness="1.8"
                                  Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="10,0,6,0">
                            <Grid>
                                <TextBlock x:Name="Text" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Visibility="{Binding IsEditingText, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                <TextBox x:Name="TextEdit" Style="{StaticResource PlainTextBox}"
                                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13" TextWrapping="Wrap" Padding="5,2" Margin="-5,-2"
                                         Background="{StaticResource NoteEditBrush}" MinHeight="22"
                                         VerticalContentAlignment="Top" AcceptsReturn="True"
                                         meiri:ClipboardEdit.Enabled="True"
                                         Visibility="{Binding IsEditingText, Converter={StaticResource BoolVis}}"
                                         IsVisibleChanged="TextEdit_IsVisibleChanged"
                                         PreviewKeyDown="TextEdit_KeyDown"
                                         LostKeyboardFocus="TextEdit_LostKeyboardFocus" />
                            </Grid>
                            <Border x:Name="NoteBox" Margin="0,3,0,0" Padding="7,0,0,0"
                                    BorderThickness="2,0,0,0" BorderBrush="{StaticResource NoteBarBrush}"
                                    Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}">
                                <TextBlock x:Name="NoteText" Text="{Binding Note}" TextWrapping="Wrap"
                                           FontSize="10.5" LineHeight="15"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <TextBox x:Name="NoteEdit" Style="{StaticResource PlainTextBox}"
                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11" TextWrapping="Wrap" Padding="7,3"
                                     Background="{StaticResource NoteEditBrush}" Margin="0,4,0,0"
                                     MinHeight="22" MaxHeight="88" VerticalContentAlignment="Top" AcceptsReturn="True"
                                     meiri:ClipboardEdit.Enabled="True"
                                     Visibility="{Binding IsEditingNote, Converter={StaticResource BoolVis}}"
                                     IsVisibleChanged="NoteEdit_IsVisibleChanged"
                                     PreviewKeyDown="NoteEdit_KeyDown"
                                     LostKeyboardFocus="NoteEdit_LostKeyboardFocus" />
                        </StackPanel>

                        <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                    Opacity="0" Margin="0,-2,-2,0">
                            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Width="22" Height="22"
                                    FontSize="10" ToolTip="添加备注" Click="Note_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Width="22" Height="22"
                                    FontSize="10" ToolTip="删除" Click="Delete_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Circle" Property="Fill" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Circle" Property="Stroke" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                    <Setter TargetName="Text" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="NoteText" Property="Foreground" Value="#CBD0DC" />
                    <Setter TargetName="NoteText" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditingNote}" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditingText}" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverBg" Property="Opacity" Value="1" />
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="20,0,8,4">
                <StackPanel x:Name="ListHost" Margin="0,2,0,8">
                    <ItemsControl x:Name="FreeHost" ItemsSource="{Binding FreeItems}"
                                  ItemTemplate="{StaticResource TaskRow}" />

                    <ItemsControl x:Name="CategoriesHost" ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CatBox" Tag="{Binding}" Background="{StaticResource GlassInnerBrush}"
                                        BorderBrush="Transparent" BorderThickness="1"
                                        CornerRadius="11" Margin="0,9,0,0" Padding="6,5,6,7"
                                        MouseLeftButtonDown="CatBox_MouseLeftButtonDown"
                                        MouseLeftButtonUp="CatBox_MouseLeftButtonUp">
                                    <StackPanel>
                                        <Border x:Name="CatHeader" Tag="{Binding}" Background="Transparent"
                                                CornerRadius="8" Padding="6,4"
                                                MouseLeftButtonDown="CatHeader_MouseLeftButtonDown"
                                                MouseMove="CatHeader_MouseMove"
                                                MouseLeftButtonUp="CatHeader_MouseLeftButtonUp">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="3" Height="14" CornerRadius="2"
                                                        Background="{StaticResource AccentBrush}"
                                                        VerticalAlignment="Center" />
                                                <Grid Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CatTitle" Text="{Binding Title}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBox x:Name="CatEdit" Style="{StaticResource PlainTextBox}"
                                                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="13" FontWeight="SemiBold" Visibility="Collapsed"
                                                             AcceptsReturn="True"
                                                             meiri:ClipboardEdit.Enabled="True"
                                                             IsVisibleChanged="CatEdit_IsVisibleChanged"
                                                             PreviewKeyDown="CatEdit_KeyDown"
                                                             LostKeyboardFocus="CatEdit_LostKeyboardFocus" />
                                                </Grid>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Items.Count, StringFormat={}{0} 项}"
                                                           FontSize="10.5" Margin="2,0,4,0"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE710;"
                                                            Width="24" Height="24" FontSize="10"
                                                            ToolTip="在此类别下添加日程" Click="CatAdd_Click" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE712;"
                                                            Width="24" Height="24" FontSize="12"
                                                            ToolTip="更多" Click="CatMore_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      ItemTemplate="{StaticResource TaskRow}"
                                                      Tag="{Binding}" Margin="14,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="CatBox" Property="Background"
                                                Value="{StaticResource GlassSelectedBrush}" />
                                        <Setter TargetName="CatBox" Property="BorderBrush"
                                                Value="{StaticResource GlassSelectedBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="CatTitle" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="CatEdit" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <Trigger SourceName="CatHeader" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CatHeader" Property="Background"
                                                Value="{StaticResource GlassInnerHoverBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="26"
                           Foreground="#DFE2EC" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Text="这一天还没有安排" FontSize="11.5" Margin="0,8,0,0"
                           Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                <Border x:Name="DropLine" Height="2" CornerRadius="1" Visibility="Collapsed"
                        Background="{StaticResource AccentBrush}" Width="100" />
            </Canvas>

            <Border x:Name="DropRing" CornerRadius="12" BorderThickness="1.5" Margin="10,4,4,2"
                    BorderBrush="{StaticResource AccentBrush}" Background="#14FFFFFF"
                    Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>

        <!-- ===== add bar ===== -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="12"
                Margin="16,4,16,15" Padding="6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource GlassSegmentBrush}" CornerRadius="9" Padding="2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeTodo" Style="{StaticResource SegmentButton}"
                                     Content="日程" IsChecked="True" Checked="Mode_Checked" />
                        <RadioButton x:Name="ModeCategory" Style="{StaticResource SegmentButton}"
                                     Content="类别" Checked="Mode_Checked" />
                    </StackPanel>
                </Border>
                <Grid Grid.Column="1" Margin="8,0,6,0">
                    <TextBox x:Name="InputBox" Style="{StaticResource PlainTextBox}" FontSize="12.5"
                             meiri:ClipboardEdit.Enabled="True"
                             KeyDown="Input_KeyDown" TextChanged="Input_TextChanged" />
                    <TextBlock x:Name="Placeholder" FontSize="12.5" Margin="2,0,0,0"
                               Foreground="{StaticResource GhostTextBrush}" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="2" Style="{StaticResource AccentIconButton}" Width="30" Height="30"
                        Content="&#xE710;" FontSize="12" ToolTip="添加" Click="Add_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
