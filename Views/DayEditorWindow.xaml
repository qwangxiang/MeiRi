<Window x:Class="MeiRi.Views.DayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="452" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="Manual" Left="0" Top="0"
        FontFamily="{StaticResource AppFont}" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid Margin="16">
        <ContentControl Style="{StaticResource CardShadowRing}" />
        <Border x:Name="Card" CornerRadius="16" Background="{StaticResource GlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="20,14,12,4" Background="Transparent">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DateTitle" FontSize="19.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <Border x:Name="TodayBadge" Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="6" Padding="6,2,6,2" Margin="9,3,0,0" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock Text="今天" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SummaryText" FontSize="11.5" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;"
                                    ToolTip="更多" FontSize="13" Click="Menu_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="关闭"
                                    FontSize="10" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl x:Name="BoardHost" Grid.Row="1" Focusable="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
