<Window x:Class="MeiRi.Views.DragGhostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MaxWidth="320"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" IsHitTestVisible="False"
        WindowStartupLocation="Manual" Left="0" Top="0"
        FontFamily="{StaticResource AppFont}" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="12">
        <Border x:Name="Card" CornerRadius="10" Background="{StaticResource GlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                Effect="{StaticResource SoftShadow}" Padding="11,7,13,7">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Height="15" CornerRadius="2" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="Label" Margin="9,0,0,0" MaxWidth="250" FontSize="12.5"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
